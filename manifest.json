{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "description": "__MSG_extDescription__",
  "version": "1.1.0",
  "default_locale": "cs",
  "browser_specific_settings": {
    "gecko": {
      "id": "jev-content-filter@local",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "__MSG_actionTitle__"
  },
  "background": {
    "scripts": [
      "dist/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.bazos.cz/*",
        "*://bazos.cz/*",
        "*://*.bazos.sk/*",
        "*://bazos.sk/*",
        "*://*.bazos.pl/*",
        "*://*.bazos.at/*"
      ],
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
